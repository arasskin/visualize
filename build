#!/bin/sh

set -e

here=$(cd "$(dirname "$0")" && pwd)
janet_src="$here/external-src/janet"
janet_out="$here/external-src/janet/janet"

case "${1:-}" in
  --clean)
    rm -f "$janet_out"
    echo "removed $janet_out"
    exit 0
    ;;
  --force)
    force=1
    ;;
  "")
    force=0
    ;;
  *)
    echo "usage: ./build [--force|--clean]" >&2
    exit 2
    ;;
esac

if [ "$force" -eq 0 ] && [ -x "$janet_out" ]; then
  stale=0
  for file in "$janet_src/janet.c" "$janet_src/janet.h" "$janet_src/shell.c"; do
    [ "$file" -nt "$janet_out" ] && stale=1
  done
  if [ "$stale" -eq 0 ]; then
    exit 0
  fi
  echo "vendored source is newer than $janet_out -- rebuilding"
fi

for file in "$janet_src/janet.c" "$janet_src/janet.h" "$janet_src/shell.c"; do
  if [ ! -f "$file" ]; then
    echo "missing $file -- the vendored runtime is incomplete" >&2
    exit 1
  fi
done

CC=${CC:-cc}
command -v "$CC" >/dev/null 2>&1 || {
  echo "no C compiler found (set CC, or install Xcode command line tools)" >&2
  exit 1
}

echo "compiling janet from external-src/janet..."

if ! "$CC" -O2 -std=c99 -fPIC -o "$janet_out" \
      "$janet_src/janet.c" "$janet_src/shell.c" -I"$janet_src" \
      -lm -lpthread -ldl 2>/dev/null; then
  "$CC" -O2 -std=c99 -fPIC -o "$janet_out" \
      "$janet_src/janet.c" "$janet_src/shell.c" -I"$janet_src" \
      -lm
fi

echo "built $janet_out ($("$janet_out" -v))"
