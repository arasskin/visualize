#!/bin/sh
#
# Run the test suite against the VENDORED runtime.
#
#     ./test/run
#
# Through bin/janet rather than whatever `janet` happens to be on PATH, so the
# suite tests the interpreter the tool will actually use. A green run against
# a different Janet than the one that ships here would not mean much.

set -e

here=$(cd "$(dirname "$0")/.." && pwd)

"$here/build"

"$here/bin/janet" "$here/test/run.janet" "$@"

# The terminal emulator is JavaScript, so its tests need a JavaScript runtime.
# Skipped rather than fatal when node is absent: node is not a dependency of
# visualize itself -- only of testing the one file that runs in a browser --
# and a missing one should not fail the suite for someone who never touches
# web/term.js.
if command -v node >/dev/null 2>&1; then
  node "$here/test/term.mjs"
else
  echo "  --  skipping terminal tests (no node on PATH)"
fi

# NOTHING MAY BE LEFT RUNNING. The suite's last test tells its supervisor to
# shut down, and for a while that reply was all it did -- the process stayed
# up, because `keep-draining` and the accept loop are `forever` fibers and
# Janet lives while any task is scheduled. The visible cost was the NEXT run of
# visualize finding a live socket, talking to the previous supervisor, and
# failing with "Bad file descriptor".
#
# Checked here rather than inside a test: one `ps` after everything has
# finished is cheap and races nothing, while polling for it mid-suite means
# spawning `ps` repeatedly alongside the ptys the tests are already running.
#
# Matched on the COMMAND AND ITS ARGUMENT, anchored to the janet binary: a
# plain grep for the filename also matches the shell that invoked this script,
# whose command line quotes it, and reports a leftover that was never there.
#
# WAITED FOR, NOT SAMPLED. Replying to `shutdown` and having exited are not the
# same instant -- a supervisor caught on its way out is not a leak. A couple of
# seconds is far longer than the exit takes and still fails fast when one is
# genuinely stuck.
# `pgrep -f` matches the process's own command line and nothing else -- unlike
# a `ps | grep`, which also sees the shell running this script and the grep
# itself, and reports leftovers that were never there. Anchoring on the
# absolute path is no good either: `ps` reports a command AS INVOKED, so a
# supervisor started as `./bin/janet` does not match one spelled in full.
# The `--supervise` flag is the discriminator: without it the same command
# line is the web server, which a suite must never count as a leak.
count_supervisors() {
  pgrep -f "visualize\.janet --supervise" 2>/dev/null | wc -l | tr -d ' '
}

survivors=$(count_supervisors)
waited=0
while [ "$survivors" -ne 0 ] && [ "$waited" -lt 20 ]; do
  sleep 0.1
  waited=$((waited + 1))
  survivors=$(count_supervisors)
done

if [ "$survivors" -ne 0 ]; then
  echo "  FAIL  $survivors supervisor process(es) survived the suite" >&2
  pgrep -lf "visualize\.janet --supervise" >&2 || true
  exit 1
fi
