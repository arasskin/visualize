(defn bind [name result & args]
  (def pointer (ffi/lookup (ffi/native) name))
  (def signature (ffi/signature :default result ;args))
  (fn [& values] (ffi/call pointer signature ;values)))
(def read-input (bind "read" :long :int :ptr :size))
(def write-output (bind "write" :long :int :ptr :size))
(def poll-input (bind "poll" :int :ptr :uint :int))
(assert (zero? (os/execute ["stty" "raw" "-echo"] :p)))
(def fds (buffer/new-filled 8 0))
(ffi/write :int 0 fds 0)
(ffi/write :int16 1 fds 4)
(def input (buffer/new-filled 1024 0))
(var mode "normal")
(var links false)
(var key "-")
(var running true)
(var pending true)
(var frozen false)
(var rows 24)
(var cols 80)

(defn emit [text]
  (var offset 0)
  (while (< offset (length text))
    (def chunk (string/slice text offset))
    (def count (int/to-number (write-output 1 chunk (length chunk))))
    (assert (pos? count) "terminal output failed")
    (+= offset count)))

(forever
  (ev/sleep 0.001)
  (when (pos? (poll-input fds 1 80))
    (def count (int/to-number (read-input 0 input (length input))))
    (when (zero? count) (break))
    (assert (pos? count) "terminal input failed")
    (for i 0 count
      (def char (string/slice input i (inc i)))
      (set key (if (peg/match ~(* (range "az" "AZ" "09") -1) char) char "-"))
      (case char
        "a" (do (set mode "alternate") (emit "\e[?1049h"))
        "n" (do (set mode "normal") (emit "\e[?1049l"))
        "l" (set links (not links))
        "m" (emit "\e[?1002h\e[?1006h")
        "f" (do (set frozen true) (set running false))
        "q" (set running false)
        "w" (do (set frozen false) (set running true))
        "s" (do (emit (string "\e[?1049l\e[H\e[2J\e[3J"
                              (string/join (seq [row :range [0 180]] (string/format "HISTORY-%04d\r\n" row)))))
                (set running false))
        "h" (do (emit "\e[?2026h") (ev/sleep 0.3) (emit "\e[?2026l"))))
    (set pending true))
  (when (or (not frozen) pending)
    (def process (os/spawn ["stty" "size"] :p {:out :pipe}))
    (def output (defer (:close (process :out)) (:read (process :out) :all)))
    (assert (zero? (os/proc-wait process)) "terminal size unavailable")
    (def dimensions (filter |(not (empty? $)) (string/split " " (string/trim (string output)))))
    (def next-rows (scan-number (dimensions 0)))
    (def next-cols (scan-number (dimensions 1)))
    (when (and (not frozen) (or (not= rows next-rows) (not= cols next-cols)))
      (set pending true))
    (set rows next-rows)
    (set cols next-cols))
  (when (or running pending)
    (set pending false)
    (def text (buffer "\e[?2026h\e[H\e[2J\e[1;1H" (string/format "PANE %dx%d %s %s" cols rows mode key)))
    (for row 1 (dec rows)
      (def link (if links (string "https://example.invalid/" row) "link"))
      (buffer/push-string text (string/format "\e[%d;1HROW-%03d \e[32mgreen\e[0m %s café λ" (inc row) row link)))
    (buffer/push-string text (string/format "\e[%d;1HBOTTOM-%dx%d\e[?2026l" rows cols rows))
    (emit (string text))))
