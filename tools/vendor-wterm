#!/bin/sh
#
# Vendor the wterm terminal emulator into external-src/wterm/, flat.
#
#     tools/vendor-wterm [version]
#
# WHY A SCRIPT AND NOT A PACKAGE MANAGER. This project has no build step and
# no node_modules: `./visualize` needs nothing installed, and the page is
# served as the files that are in the repository. So the dependency is COPIED
# IN, once, by this -- and re-running it with a version is how it is changed.
#
# FLAT, because the static route serves a single path component and refuses
# anything with a slash in it, which is the whole of its path safety. Each
# package's modules are prefixed with the package name and their relative
# imports are rewritten to match; the BARE specifiers (`@wterm/core`) are
# resolved by the import map in index.html, which is the one place the
# flattened names are spelled out.
set -e

version="${1:-0.3.4}"
here=$(cd "$(dirname "$0")/.." && pwd)
# VENDORED CODE LIVES WITH THE OTHER VENDORED CODE, beside janet's source
# rather than mixed into src/web/, which holds what this project wrote. The
# server serves both directories by bare filename -- see `static-roots` in
# core.janet -- so the import map and the page are unaffected by which of
# the two a file sits in.
web="$here/external-src/wterm"
mkdir -p "$web"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

cd "$work"
for pkg in core dom ghostty; do
  npm pack "@wterm/$pkg@$version" >/dev/null 2>&1
  mkdir -p "$pkg"
  tar xzf "wterm-$pkg-$version.tgz" -C "$pkg"
done

for pkg in core dom ghostty; do
  for src in "$work/$pkg/package/dist/"*.js; do
    base=$(basename "$src" .js)
    if [ "$base" = "index" ]; then
      out="$web/wterm-$pkg.js"
    else
      out="$web/wterm-$pkg-$base.js"
    fi
    # Relative imports point at the flattened names. A package's own entry
    # point keeps the short name, so `./index.js` becomes `./wterm-<pkg>.js`
    # rather than `./wterm-<pkg>-index.js`.
    #
    # The sourceMappingURL comments go: the .map files are not vendored, and a
    # comment naming a file that is not there makes the browser ask for it and
    # log a 404 on every load.
    sed -E \
      -e "s#(from \"|import\(\")\./index\.js#\1./wterm-$pkg.js#g" \
      -e "s#(from \"|import\(\")\./([a-z-]+)\.js#\1./wterm-$pkg-\2.js#g" \
      -e '/^\/\/# sourceMappingURL=/d' \
      "$src" > "$out"
  done
done

# -- A KNOWN BUG, AND WHY THERE IS NO PATCH HERE -------------------------------
#
# SCROLLING DOES NOTHING INSIDE CLAUDE CODE, and the cause is in the WASM,
# which is why nothing in this script fixes it.
#
# Claude asks for mouse reports with `?1000h ?1002h ?1003h ?1006h` -- all
# four, in that order, and it never sets `?1007h` (xterm's Alternate Scroll,
# the other way a program can ask for the wheel). Mode 1003 is ANY-EVENT
# tracking and it is the LAST one set, so it is the one in force.
#
# ghostty-vt.wasm does not implement 1003. Fed the modes one at a time into
# a clean core, `mouse_tracking` answers:
#
#     ?1000h -> 1000        ?1003h -> 0     <-- reset, not 1003
#     ?1002h -> 1002        ?1006h -> 0
#
# So the engine ends with tracking OFF. wterm's input handler then returns
# without sending anything (correctly -- it is told there is no tracking),
# the wheel report never reaches claude, and the alternate screen has no
# scrollback to fall back on. Nothing scrolls.
#
# THE JS IS NOT WHERE TO FIX IT. @wterm/ghostty does clamp anything that is
# not 1000 or 1002 to 0, which looks like the bug and is not: by the time it
# reads the mode, the wasm has already answered 0. Patching that clamp here
# was tried and changed nothing.
#
# WHAT WOULD FIX IT is 1003 support in ghostty-vt itself, upstream of this
# repo and of @wterm. Not yet reported.

cp "$work/ghostty/package/wasm/ghostty-vt.wasm" "$web/ghostty-vt.wasm"

# THE STYLESHEET IS NOT OPTIONAL, and it is not in dist/ with the modules --
# the package exports it as `@wterm/dom/css` from src/. Skipping it the first
# time cost two bugs that looked like ours: `.wterm.has-scrollback` is the
# rule that gives the scroller its overflow, so history was unreachable, and
# the `contain:` declarations on the grid and rows are what keep a repaint
# from touching the rest of the page.
#
# Taken as-is. Our own rules (see style.css) override the theme, the padding
# and the radius afterwards, which is the supported way round -- editing a
# vendored file would be undone by the next run of this script.
cp "$work/dom/package/src/terminal.css" "$web/wterm.css"

echo "vendored wterm $version into external-src/wterm/:"
ls -1 "$web"/wterm-*.js "$web/wterm.css" "$web/ghostty-vt.wasm" | sed "s#^$web/#  #"
