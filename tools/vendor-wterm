#!/bin/sh
#
# Vendor the wterm terminal emulator into src/web/, flat.
#
#     tools/vendor-wterm [version]
#
# WHY A SCRIPT AND NOT A PACKAGE MANAGER. This project has no build step and
# no node_modules: `./visualize` needs nothing installed, and the page is
# served as the files that are in the repository. So the dependency is COPIED
# IN, once, by this -- and re-running it with a version is how it is changed.
#
# FLAT, because the static route serves a single path component and refuses
# anything with a slash in it, which is the whole of its path safety. Each
# package's modules are prefixed with the package name and their relative
# imports are rewritten to match; the BARE specifiers (`@wterm/core`) are
# resolved by the import map in index.html, which is the one place the
# flattened names are spelled out.
set -e

version="${1:-0.3.4}"
here=$(cd "$(dirname "$0")/.." && pwd)
web="$here/src/web"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

cd "$work"
for pkg in core dom ghostty; do
  npm pack "@wterm/$pkg@$version" >/dev/null 2>&1
  mkdir -p "$pkg"
  tar xzf "wterm-$pkg-$version.tgz" -C "$pkg"
done

for pkg in core dom ghostty; do
  for src in "$work/$pkg/package/dist/"*.js; do
    base=$(basename "$src" .js)
    if [ "$base" = "index" ]; then
      out="$web/wterm-$pkg.js"
    else
      out="$web/wterm-$pkg-$base.js"
    fi
    # Relative imports point at the flattened names. A package's own entry
    # point keeps the short name, so `./index.js` becomes `./wterm-<pkg>.js`
    # rather than `./wterm-<pkg>-index.js`.
    #
    # The sourceMappingURL comments go: the .map files are not vendored, and a
    # comment naming a file that is not there makes the browser ask for it and
    # log a 404 on every load.
    sed -E \
      -e "s#(from \"|import\(\")\./index\.js#\1./wterm-$pkg.js#g" \
      -e "s#(from \"|import\(\")\./([a-z-]+)\.js#\1./wterm-$pkg-\2.js#g" \
      -e '/^\/\/# sourceMappingURL=/d' \
      "$src" > "$out"
  done
done

cp "$work/ghostty/package/wasm/ghostty-vt.wasm" "$web/ghostty-vt.wasm"

echo "vendored wterm $version into src/web/:"
ls -1 "$web"/wterm-*.js "$web/ghostty-vt.wasm" | sed "s#^$web/#  #"
