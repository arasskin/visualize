#!/bin/sh
#
# Run visualize on a directory, building the runtime first if it is not built.
#
#     ./run                 the current directory
#     ./run ~/code/project  somewhere else
#     ./run --no-dev [dir]  ...without the repl into the live server (see README)
#
# This is the entry point to use. `./build` runs underneath it and does
# nothing when the runtime is already compiled, so the first run pays a few
# seconds and every run after it starts immediately.

set -e

here=$(cd "$(dirname "$0")" && pwd)

"$here/build"

exec "$here/bin/janet" "$here/visualize.janet" "$@"
