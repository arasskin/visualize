#!/bin/sh
#
# The tools the harness comes with.
#
#     vz scan [pattern]     what the program knows about this source tree
#     vz faults [n]         what has gone wrong lately, with stacks
#     vz eval '(expr)'      evaluate in the running server's own image
#     vz pane repl 'text'   type into a pane, where a person can watch
#     vz state [name]       list or print the facts on disk
#     vz where              this run's url, token file, state directory
#
# WHY THESE EXIST. The harness thread holds the intelligence -- claude, pi,
# whatever the config names -- but until now visualize offered it nothing:
# an agent arrived with its own tools and this program was just a terminal
# for it to run in. These are the small set that comes with every harness,
# and they are the ones the program can offer that a general-purpose agent
# cannot bring: what THIS program knows about THIS source tree, what it has
# seen go wrong, and its own live image.
#
# A SHELL COMMAND, not a protocol. The harness is a pty running somebody
# else's program, so the only interface it reliably has is a command line.
# Everything here reads the state files or posts to the endpoints -- there
# is no privileged channel, and anything below could be written by hand.

set -e

here=$(cd "$(dirname "$0")" && pwd)
tmp=${TMPDIR:-/tmp}

endpoint=$(ls -t "${tmp%/}"/visualize-*.endpoint.json 2>/dev/null | head -n 1)
if [ -z "$endpoint" ] || [ ! -f "$endpoint" ]; then
  echo "no running visualize -- start one with ./visualize" >&2
  exit 1
fi

url=$(sed 's/.*"url":"\([^"]*\)".*/\1/' "$endpoint")
token=$(sed 's/.*"token":"\([^"]*\)".*/\1/' "$endpoint")

# Where the state lives. The server serves one root; ask it rather than
# guessing from the working directory, which an agent may have changed.
root=$(curl -s -m 5 "$url/root?k=$token" 2>/dev/null | sed 's/.*"root":"\([^"]*\)".*/\1/')
[ -z "$root" ] && root=$(pwd)
state="$root/.visualize"

command=${1:-help}
[ $# -gt 0 ] && shift

case "$command" in
  scan)
    # The graph as facts, not a picture: which files exist, what each one
    # depends on, how big it is. Filtered by a substring when given one.
    python3 - "$state/scan.json" "${1:-}" <<'PY'
import json, sys
path, pattern = sys.argv[1], sys.argv[2]
try:
    scan = json.load(open(path))
except FileNotFoundError:
    print("no scan yet -- load the page once, or run: vz eval '(graph/draw ...)'",
          file=sys.stderr)
    sys.exit(1)
nodes = scan.get("nodes", [])
edges = scan.get("edges", [])
sizes = scan.get("sizes", {})
if pattern:
    nodes = [n for n in nodes if pattern in n.get("name", "")]
    names = {n["name"] for n in nodes}
    edges = [e for e in edges if e[0] in names or e[1] in names]
print(f"{len(nodes)} files, {len(edges)} edges"
      + (f"  (matching {pattern!r})" if pattern else ""))
# An edge is [imported, importer] -- the arrow graphviz draws, pointing at
# whoever depends on it. Read the other way round for "what does this need".
for node in sorted(nodes, key=lambda n: -sizes.get(n["name"], 0))[:40]:
    name = node["name"]
    needs = sorted(a for a, b in edges if b == name)
    used_by = sorted(b for a, b in edges if a == name)
    line = f"  {name}"
    if sizes.get(name):
        line += f"  {sizes[name]} lines"
    if needs:
        line += f"  needs {', '.join(needs[:5])}"
        if len(needs) > 5:
            line += f" (+{len(needs)-5})"
    if used_by:
        line += f"  <- used by {len(used_by)}"
    print(line)
PY
    ;;

  faults)
    # What the server hit, newest last, with the stacks. From the file, so
    # this works after a crash that took the server with it.
    python3 - "$state/faults.jsonl" "${1:-5}" <<'PY'
import json, sys, time
path, count = sys.argv[1], int(sys.argv[2])
try:
    lines = [l for l in open(path) if l.strip()]
except FileNotFoundError:
    print("no faults recorded")
    sys.exit(0)
for line in lines[-count:]:
    fault = json.loads(line)
    when = time.strftime("%H:%M:%S", time.localtime(fault["at"]))
    print(f"{when}  {fault['kind']}  {fault['where']}")
    print(f"    {fault['what']}")
    for trace_line in (fault.get("trace") or "").rstrip().split("\n"):
        if trace_line.strip():
            print(f"    {trace_line}")
PY
    ;;

  eval)
    # The running image. This is the introspection the repl thread exists
    # for, reached from the harness thread -- and it goes THROUGH THE PANE,
    # so what the agent evaluates is on screen for a person to see.
    [ -z "${1:-}" ] && { echo "usage: vz eval '(some expression)'" >&2; exit 2; }
    exec "$here/pane" repl "$1"
    ;;

  pane)
    exec "$here/pane" "$@"
    ;;

  state)
    if [ -z "${1:-}" ]; then
      ls -1 "$state" 2>/dev/null || echo "no state yet"
    else
      cat "$state/$1"
    fi
    ;;

  where)
    echo "url:      $url"
    echo "root:     $root"
    echo "state:    $state"
    echo "endpoint: $endpoint"
    ;;

  help|*)
    sed -n '3,16p' "$0" | sed 's/^# \{0,1\}//'
    ;;
esac
