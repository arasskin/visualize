#!/bin/sh
#
# The tools the harness comes with.
#
#     vz scan [pattern]     what the program knows about this source tree
#     vz faults [n]         what has gone wrong lately, with stacks
#     vz reload             load your edits into the running server
#     vz eval '(expr)'      evaluate in the running server's own image
#     vz pane repl 'text'   type into a pane, where a person can watch
#     vz shot [file]        the graph as it looks right now (SVG, or .png)
#     vz dot [file]         the same graph through graphviz, for comparison
#     vz state [name]       list or print the facts on disk
#     vz where              this run's url, token file, state directory
#
# CHANGED A FILE AND WANT TO SEE IT? `vz reload && vz shot out.png`. The
# server runs from a loaded image, so an edit on disk changes nothing it
# draws until the module is reloaded -- and a fresh `janet` you run yourself
# will happily disagree with the page for exactly that reason.
#
# WHY THESE EXIST. The harness thread holds the intelligence -- claude, pi,
# whatever the config names -- but until now visualize offered it nothing:
# an agent arrived with its own tools and this program was just a terminal
# for it to run in. These are the small set that comes with every harness,
# and they are the ones the program can offer that a general-purpose agent
# cannot bring: what THIS program knows about THIS source tree, what it has
# seen go wrong, and its own live image.
#
# A SHELL COMMAND, not a protocol. The harness is a pty running somebody
# else's program, so the only interface it reliably has is a command line.
# Everything here reads the state files or posts to the endpoints -- there
# is no privileged channel, and anything below could be written by hand.

set -e

here=$(cd "$(dirname "$0")" && pwd)
tmp=${TMPDIR:-/tmp}

endpoint=$(ls -t "${tmp%/}"/visualize-*.endpoint.json 2>/dev/null | head -n 1)
if [ -z "$endpoint" ] || [ ! -f "$endpoint" ]; then
  echo "no running visualize -- start one with ./visualize" >&2
  exit 1
fi

url=$(sed 's/.*"url":"\([^"]*\)".*/\1/' "$endpoint")
token=$(sed 's/.*"token":"\([^"]*\)".*/\1/' "$endpoint")

# Where the state lives. The server serves one root; ask it rather than
# guessing from the working directory, which an agent may have changed.
root=$(curl -s -m 5 "$url/root?k=$token" 2>/dev/null | sed 's/.*"root":"\([^"]*\)".*/\1/')
[ -z "$root" ] && root=$(pwd)
state="$root/.visualize"

command=${1:-help}
[ $# -gt 0 ] && shift

case "$command" in
  scan)
    # The graph as facts, not a picture: which files exist, what each one
    # depends on, how big it is. Filtered by a substring when given one.
    python3 - "$state/scan.json" "${1:-}" <<'PY'
import json, sys
path, pattern = sys.argv[1], sys.argv[2]
try:
    scan = json.load(open(path))
except FileNotFoundError:
    print("no scan yet -- load the page once, or run: vz eval '(graph/draw ...)'",
          file=sys.stderr)
    sys.exit(1)
nodes = scan.get("nodes", [])
edges = scan.get("edges", [])
sizes = scan.get("sizes", {})
if pattern:
    nodes = [n for n in nodes if pattern in n.get("name", "")]
    names = {n["name"] for n in nodes}
    edges = [e for e in edges if e[0] in names or e[1] in names]
print(f"{len(nodes)} files, {len(edges)} edges"
      + (f"  (matching {pattern!r})" if pattern else ""))
# An edge is [imported, importer] -- the arrow points at whoever depends on
# it, which is the direction the graph draws. Read the other way round for "what does this need".
for node in sorted(nodes, key=lambda n: -sizes.get(n["name"], 0))[:40]:
    name = node["name"]
    needs = sorted(a for a, b in edges if b == name)
    used_by = sorted(b for a, b in edges if a == name)
    line = f"  {name}"
    if sizes.get(name):
        line += f"  {sizes[name]} lines"
    if needs:
        line += f"  needs {', '.join(needs[:5])}"
        if len(needs) > 5:
            line += f" (+{len(needs)-5})"
    if used_by:
        line += f"  <- used by {len(used_by)}"
    print(line)
PY
    ;;

  faults)
    # What the server hit, newest last, with the stacks. From the file, so
    # this works after a crash that took the server with it.
    python3 - "$state/faults.jsonl" "${1:-5}" <<'PY'
import json, sys, time
path, count = sys.argv[1], int(sys.argv[2])
try:
    lines = [l for l in open(path) if l.strip()]
except FileNotFoundError:
    print("no faults recorded")
    sys.exit(0)
for line in lines[-count:]:
    fault = json.loads(line)
    when = time.strftime("%H:%M:%S", time.localtime(fault["at"]))
    print(f"{when}  {fault['kind']}  {fault['where']}")
    print(f"    {fault['what']}")
    for trace_line in (fault.get("trace") or "").rstrip().split("\n"):
        if trace_line.strip():
            print(f"    {trace_line}")
PY
    ;;

  eval)
    # The running image. This is the introspection the repl thread exists
    # for, reached from the harness thread -- and it goes THROUGH THE PANE,
    # so what the agent evaluates is on screen for a person to see.
    [ -z "${1:-}" ] && { echo "usage: vz eval '(some expression)'" >&2; exit 2; }
    exec "$here/pane" repl "$1"
    ;;

  pane)
    exec "$here/pane" "$@"
    ;;

  reload)
    # THE SERVER HOLDS A LOADED IMAGE, and editing a file does not change it.
    # That is the single most expensive thing to not know about this program:
    # a change looks like it did nothing, the numbers you measure in a fresh
    # process disagree with the page, and you go looking for a bug in the
    # code you just wrote. It cost a full session once.
    #
    # So: reload what git says you changed, innermost first, then re-render.
    # Innermost first because a module that imports another holds bindings
    # from it -- reloading `layout/layered` alone leaves `layout.janet` and
    # `graph.janet` still calling the version they compiled against, so the
    # picture does not move and the reload looks broken.
    #
    # Depth is the count of slashes: src/layout/layered.janet reloads before
    # src/layout.janet, which reloads before src/graph.janet.
    changed=$(cd "$root" && git diff --name-only HEAD -- 'src/*.janet' 2>/dev/null)
    [ -z "$changed" ] && changed=$(cd "$root" && git diff --cached --name-only HEAD -- 'src/*.janet' 2>/dev/null)
    if [ -z "$changed" ]; then
      echo "nothing changed under src/ -- the image is already what the files say" >&2
      exit 0
    fi
    # Deepest path first.
    ordered=$(printf '%s\n' $changed | awk '{print gsub(/\//,"/"), $0}' | sort -rn | cut -d' ' -f2-)
    for file in $ordered; do
      printf 'reloading %s ... ' "$file"
      # `dofile` on the module's own env, by exact path -- see dev/reload.
      # The repl colours its output, so `error:` arrives wrapped in escape
      # sequences and a plain match for it silently never fires -- which is
      # how this reported "ok" for a file with a syntax error in it. Strip
      # the escapes before looking, and look at the WHOLE answer: the
      # stacktrace is several lines and the word is on the first of them.
      answer=$("$here/pane" repl "(dev/reload \"$file\")" 2>&1 \
               | sed $'s/\033\\[[0-9;]*m//g')
      case "$answer" in
        *"error:"*|*"parse error"*|*"compile error"*)
          printf 'FAILED\n' >&2
          printf '%s\n' "$answer" | grep -E 'error' >&2
          # A failed reload leaves the repl inside the debugger, where every
          # later expression is evaluated in the wrong environment -- so the
          # next reload would "succeed" against nothing. Leave it clean.
          #
          # ONE `(quit)` PER LEVEL: debuggers nest, so a session that has
          # tripped twice sits at debug[2] and a single quit only gets back
          # to debug[1], which looks fine in passing and is not.
          #
          # The prompt after each quit says where it landed -- `visualize:`
          # once it is out, `debug[n]:` while it is not -- so quit until it
          # says the former. Reading the answer to the quit ITSELF is what
          # makes this work: asking the pane separately returns nothing to
          # match on, since an empty line types nothing and prints nothing.
          for _ in 1 2 3 4 5; do
            case $("$here/pane" repl '(quit)' 2>&1 | tail -1) in
              *debug*) ;;
              *) break ;;
            esac
          done
          exit 1 ;;
        *) printf 'ok\n' ;;
      esac
    done
    echo "the running image now matches the files"
    ;;

  shot)
    # WHAT THE GRAPH LOOKS LIKE, for an agent that just changed something
    # and wants to see the result rather than trust it. SVG by default
    # because SVG is TEXT: a tool that can read a file can read the node
    # names, the positions and the edges out of it, which no raster format
    # allows. Ask for a .png and it is rasterized instead -- useful for a
    # human, or for a model that can look at images.
    out=${1:-}
    if [ -z "$out" ]; then
      out=$(mktemp -t visualize-shot).svg
    fi
    case "$out" in
      *.png)
        svg=$(mktemp -t visualize-shot).svg
        curl -fsS -m 20 "$url/graph.svg?k=$token" -o "$svg"
        # qlmanage and sips ship with macOS, so a PNG costs no dependency.
        # rsvg-convert is better when it happens to be installed.
        if command -v rsvg-convert >/dev/null 2>&1; then
          rsvg-convert -o "$out" "$svg"
        elif command -v qlmanage >/dev/null 2>&1; then
          dir=$(mktemp -d)
          qlmanage -t -s 1600 -o "$dir" "$svg" >/dev/null 2>&1
          mv "$dir"/*.png "$out" 2>/dev/null || {
            echo "could not rasterize; the SVG is at $svg" >&2; exit 1; }
          rm -rf "$dir"
        else
          echo "no rasterizer found; the SVG is at $svg" >&2
          exit 1
        fi
        rm -f "$svg"
        ;;
      *)
        curl -fsS -m 20 "$url/graph.svg?k=$token" -o "$out"
        ;;
    esac
    # The path on stdout, so a caller can pipe it straight into a Read.
    echo "$out"
    ;;

  dot)
    # THE SAME GRAPH THROUGH GRAPHVIZ, for comparison. The layout here
    # replaced graphviz, and every argument about whether a change moved
    # toward or away from it deserves a picture on each side --
    # tools/dot.janet exports exactly what the page draws (same scan,
    # config, groups, labels), so the only variable is the algorithm.
    # A .dot file skips graphviz entirely; .svg or .png (the default)
    # need `dot` on PATH, which is not a dependency of visualize --
    # that is the point -- so its absence is reported, not required.
    out=${1:-$(mktemp -t visualize-dot).png}
    dotfile=$(mktemp -t visualize-dot).dot
    (cd "$root" && ./bin/janet tools/dot.janet) > "$dotfile"
    case "$out" in
      *.dot)
        mv "$dotfile" "$out"
        ;;
      *)
        if ! command -v dot >/dev/null 2>&1; then
          echo "graphviz is not installed; the DOT file is at $dotfile" >&2
          exit 1
        fi
        case "$out" in
          *.svg) dot -Tsvg "$dotfile" -o "$out" ;;
          *)     dot -Tpng -Gdpi=110 "$dotfile" -o "$out" ;;
        esac
        rm -f "$dotfile"
        ;;
    esac
    echo "$out"
    ;;

  state)
    if [ -z "${1:-}" ]; then
      ls -1 "$state" 2>/dev/null || echo "no state yet"
    else
      cat "$state/$1"
    fi
    ;;

  where)
    echo "url:      $url"
    echo "root:     $root"
    echo "state:    $state"
    echo "endpoint: $endpoint"
    ;;

  help|*)
    sed -n '3,18p' "$0" | sed 's/^# \{0,1\}//'
    ;;
esac
